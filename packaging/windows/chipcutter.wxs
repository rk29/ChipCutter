<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="ChipCutter"
      Manufacturer="ChipCutter Contributors"
      Version="$(var.Version)"
      UpgradeCode="B7C9D3A4-5F12-4E8B-9A61-3C4E8F2D7105"
      Scope="perMachine"
      InstallerVersion="500">
    <SummaryInformation
        Description="ChipCutter - Open-source 2.5D, 3-Axis, and 4th-Axis Desktop CAM and G-Code Verification Suite" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ChipCutterIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ChipCutterIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/rk29/ChipCutter" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/rk29/ChipCutter" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ChipCutter" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ChipCutter" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="ChipCutter" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- Desktop GUI executable and .chipz project bundle file association.
           Note: Windows MSI Extension only binds the final extension segment;
           generic .toml is intentionally left unassociated to avoid hijacking
           plain TOML files from text editors. Users can open .chip.toml via
           File -> Open or by passing the file path to chip-gui.exe. -->
      <Component Id="ChipGuiExecutable" Guid="E4A82C11-7D3B-4A9E-8F14-2B6C91D50A31">
        <File Id="ChipGuiExe" Source="$(var.StageDir)\chip-gui.exe" KeyPath="yes" />
        <ProgId
            Id="ChipCutter.ProjectBundle"
            Description="ChipCutter Project Bundle (.chipz)"
            Icon="ChipGuiExe"
            IconIndex="0">
          <Extension Id="chipz" ContentType="application/vnd.chipcutter.bundle">
            <Verb
                Id="open"
                Command="Open with ChipCutter"
                TargetFile="ChipGuiExe"
                Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
      </Component>

      <!-- Headless CLI executable and system PATH registration -->
      <Component Id="ChipCliExecutable" Guid="9F31A6D8-2E4C-4B75-A1D2-8C0E45B73F92">
        <File Id="ChipCliExe" Source="$(var.StageDir)\chipcutter.exe" KeyPath="yes" />
        <Environment
            Id="ChipCutterPath"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Permanent="no"
            Part="last"
            Action="set"
            System="yes" />
      </Component>

      <Component Id="LicenseMitComponent" Guid="5A7E1C49-8B20-4D63-9E41-1F8B62A04C78">
        <File Id="LicenseMitFile" Source="$(var.StageDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>

      <Component Id="LicenseApacheComponent" Guid="2D6B4F81-9C15-4E70-B3A2-6E9D10C48B53">
        <File Id="LicenseApacheFile" Source="$(var.StageDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>

      <Component Id="ReadmeComponent" Guid="7C18E3A5-4F92-4D06-8B57-3A1E94F26D80">
        <File Id="ReadmeFile" Source="$(var.StageDir)\README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ShortcutComponents" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="C84F2D19-6A37-4E51-B9C2-7D3E18A46F02">
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="ChipCutter"
            Description="ChipCutter - 2.5D, 3-Axis, &amp; 4th-Axis CAM"
            Target="[#ChipGuiExe]"
            WorkingDirectory="INSTALLFOLDER"
            Icon="ChipCutterIcon.ico" />
        <RemoveFolder
            Id="RemoveApplicationProgramsFolder"
            Directory="ApplicationProgramsFolder"
            On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\ChipCutter"
            Name="StartMenuShortcutInstalled"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
